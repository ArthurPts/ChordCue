APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chordcue
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# ── Queue ──────────────────────────────────────────────────
# Gunakan 'sync' agar job (TTS audio) langsung dieksekusi seketika tanpa worker.
# Gunakan 'database' jika ingin diproses background oleh worker/Supervisor.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

# ── TTS (Text-to-Speech untuk Audio Chord) ─────────────────
# Perintah edge-tts:
#   Windows (py launcher) : TTS_COMMAND="py -m edge_tts"
#   Linux (pip global)    : TTS_COMMAND=edge-tts
#   Linux (pip user)      : TTS_COMMAND="python3 -m edge_tts"
TTS_COMMAND="py -m edge_tts"

# Suara TTS (Default: English)
#   English  : en-US-AriaNeural (wanita), en-US-GuyNeural (pria)
#   Indonesia: id-ID-ArdiNeural (pria), id-ID-GadisNeural (wanita)
TTS_VOICE=en-US-AriaNeural

# Kecepatan bicara: "+0%", "-10%", "+20%"
TTS_RATE=-10%

# Aktifkan/nonaktifkan TTS (false = seeder tidak mengantre audio)
TTS_ENABLED=true


MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
